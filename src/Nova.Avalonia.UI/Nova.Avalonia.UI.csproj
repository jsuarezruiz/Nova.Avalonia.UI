<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <VersionPrefix>1.0.0</VersionPrefix>
        <IsPackable>true</IsPackable>
        <PackageId>Nova.Avalonia.UI</PackageId>
        <Title>Nova Avalonia UI</Title>
        <Authors>Javier Suárez Ruiz</Authors>
        <Company>Javier Suárez Ruiz</Company>
        <Description>Accessible, themeable controls and high-performance layout panels for Avalonia applications.</Description>
        <Copyright>Copyright © 2025-2026 Javier Suárez Ruiz</Copyright>
        <PackageProjectUrl>https://github.com/jsuarezruiz/Nova.Avalonia.UI</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jsuarezruiz/Nova.Avalonia.UI.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>package-icon.png</PackageIcon>
        <PackageTags>avalonia avaloniaui ui controls layouts cross-platform accessibility xaml</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Themes\**" />
        <None Include="README.NuGet.md" Pack="true" PackagePath="README.md" />
        <None Include="..\..\images\package-icon.png" Pack="true" PackagePath="package-icon.png" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>
    
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Nova.Avalonia.UI.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    
</Project>
