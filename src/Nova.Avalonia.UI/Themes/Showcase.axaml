<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nova="using:Nova.Avalonia.UI.Controls">

    <!-- ShowcaseOverlay Style -->
    <Style Selector="nova|ShowcaseOverlay">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ShowcaseTooltip Style -->
    <Style Selector="nova|ShowcaseTooltip">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="0 4 16 0 #40000000">
                    <StackPanel Spacing="12">
                        <StackPanel Name="PART_DefaultBody"
                                    Spacing="12"
                                    IsVisible="{TemplateBinding ShowDefaultBody}">
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{TemplateBinding Description}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <ContentPresenter Name="PART_CustomBody"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{TemplateBinding ShowCustomBody}" />

                        <ContentPresenter Content="{TemplateBinding FooterContent}"
                                          ContentTemplate="{TemplateBinding FooterContentTemplate}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Showcase Style -->
    <Style Selector="nova|Showcase">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="nova:Showcase">
                <Panel IsVisible="{Binding IsActive, RelativeSource={RelativeSource TemplatedParent}}">
                    <nova:ShowcaseOverlay Name="PART_Overlay"
                                          OverlayBrush="{TemplateBinding OverlayBrush}"
                                          IsHitTestVisible="False" />

                    <Canvas HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Name="PART_ModalBlocker"
                                IsVisible="False"
                                Background="Transparent" />
                        <Border Name="PART_TopBlocker"
                                IsVisible="False"
                                Background="Transparent" />
                        <Border Name="PART_LeftBlocker"
                                IsVisible="False"
                                Background="Transparent" />
                        <Border Name="PART_RightBlocker"
                                IsVisible="False"
                                Background="Transparent" />
                        <Border Name="PART_BottomBlocker"
                                IsVisible="False"
                                Background="Transparent" />
                    </Canvas>

                    <Canvas HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <nova:ShowcaseTooltip Name="PART_Tooltip"
                                              AutomationProperties.AutomationId="ShowcaseTooltip"
                                              AutomationProperties.LiveSetting="Assertive">
                            <nova:ShowcaseTooltip.FooterContent>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Name="PART_SkipButton" />
                                    <Button Name="PART_PreviousButton" />
                                    <Button Name="PART_NextButton" Classes="accent" />
                                </StackPanel>
                            </nova:ShowcaseTooltip.FooterContent>
                        </nova:ShowcaseTooltip>
                    </Canvas>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
