<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Nova.Avalonia.UI.Controls">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GravatarBackgroundBrush" Color="#F0F0F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GravatarBackgroundBrush" Color="#2A2A2A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="controls|Gravatar">
        <Setter Property="Width" Value="{Binding Size, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Height" Value="{Binding Size, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{DynamicResource GravatarBackgroundBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:HalfValueConverter.Instance}}"
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True">
                    <Panel>
                        <Image Name="PART_ImagePresenter"
                               Stretch="UniformToFill"
                               IsVisible="False" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Margin="4"
                                          IsVisible="False" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
