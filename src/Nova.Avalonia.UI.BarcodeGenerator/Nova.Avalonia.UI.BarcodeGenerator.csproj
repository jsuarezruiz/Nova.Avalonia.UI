<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <VersionPrefix>1.0.0</VersionPrefix>
        <IsPackable>true</IsPackable>
        <PackageId>Nova.Avalonia.UI.BarcodeGenerator</PackageId>
        <Title>Nova Avalonia UI Barcode Generator</Title>
        <Authors>Javier Suárez Ruiz</Authors>
        <Company>Javier Suárez Ruiz</Company>
        <Description>QR code, linear barcode, and matrix barcode generation for Avalonia applications, powered by ZXing.Net.</Description>
        <Copyright>Copyright © 2025-2026 Javier Suárez Ruiz</Copyright>
        <PackageProjectUrl>https://github.com/jsuarezruiz/Nova.Avalonia.UI</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jsuarezruiz/Nova.Avalonia.UI.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>package-icon.png</PackageIcon>
        <PackageTags>avalonia avaloniaui barcode qrcode qr-code zxing controls cross-platform</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Themes\**" />
        <None Include="README.NuGet.md" Pack="true" PackagePath="README.md" />
        <None Include="..\..\images\package-icon.png" Pack="true" PackagePath="package-icon.png" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>
    
</Project>
