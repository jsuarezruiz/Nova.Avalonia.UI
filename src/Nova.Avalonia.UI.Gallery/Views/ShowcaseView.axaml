<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nova.Avalonia.UI.Gallery.ViewModels"
             xmlns:nova="using:Nova.Avalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Nova.Avalonia.UI.Gallery.Views.ShowcaseView"
             x:DataType="vm:ShowcaseViewModel">
    <Design.DataContext>
        <vm:ShowcaseViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Sample UI to showcase -->
        <Grid Margin="24">
            <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                <TextBlock Text="Welcome to Nova.Avalonia.UI"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           nova:Showcase.Key="WelcomeTitle" />
                
                <TextBlock Text="This is a sample application demonstrating the Showcase control. Click the button below to start an interactive tutorial."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.8" />
                
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="Start Tutorial"
                            Classes="accent"
                            Padding="16,10"
                            nova:Showcase.Key="StartButton" />
                    
                    <Button Content="Settings"
                            Padding="16,10"
                            nova:Showcase.Key="SettingsButton" />
                </StackPanel>
                
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        nova:Showcase.Key="InfoCard">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sample Card"
                                   FontWeight="SemiBold"
                                   FontSize="16" />
                        <TextBlock Text="This is a sample information card that could be highlighted in your tutorial."
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>
                
                <TextBox Watermark="Search..."
                         Width="300"
                         HorizontalAlignment="Center"
                         nova:Showcase.Key="SearchBox" />
            </StackPanel>
        </Grid>
        
        <!-- Showcase control - just bind Controller and set IsActive -->
        <nova:Showcase x:Name="ShowcaseControl"
                       OverlayBrush="#CC000000" />
    </Panel>
</UserControl>
