<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Nova.Avalonia.UI.Controls;assembly=Nova.Avalonia.UI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1200"
             x:Class="Nova.Avalonia.UI.Gallery.Views.CompareSliderView">
    <UserControl.Resources>
        <StreamGeometry x:Key="CodeIcon">M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6M13.5,3.6L16.2,4.4L10.5,20.4L7.8,19.6L13.5,3.6Z</StreamGeometry>
    </UserControl.Resources>

    <ScrollViewer Margin="20">
        <StackPanel Spacing="20">

            <!-- Basic Usage -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Basic Usage" />
                    <TextBlock Text="Side-by-side image comparison." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider Height="300">
                        <controls:CompareSlider.BeforeContent>
                            <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/summer.png" Stretch="UniformToFill" />
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/winter.png" Stretch="UniformToFill" />
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>
                </StackPanel>
            </Border>

            <!-- Vertical Orientation (Image Comparison) -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Vertical Orientation" />
                    <TextBlock Text="Compare content vertically (e.g., photo editing effects)." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider Orientation="Vertical" Height="300">
                         <controls:CompareSlider.BeforeContent>
                             <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/cyberpunk.png" Stretch="UniformToFill">
                                 <Image.Effect>
                                     <BlurEffect Radius="15"/>
                                 </Image.Effect>
                             </Image>
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/cyberpunk.png" Stretch="UniformToFill" />
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>
                </StackPanel>
            </Border>
            
            <!-- Interactive Control -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Interactive Control" />
                    <TextBlock Text="Control the slider programmatically." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider x:Name="InteractiveSlider" Height="200" Value="0.5">
                        <controls:CompareSlider.BeforeContent>
                             <Border Background="#212121">
                                 <TextBlock Text="DARK MODE" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                             </Border>
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Border Background="#FAFAFA">
                                 <TextBlock Text="LIGHT MODE" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                             </Border>
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>
                    
                    <WrapPanel Orientation="Horizontal" >
                         <Button Content="Animate to Start" Click="OnAnimateToStartClick" Margin="0,0,10,10"/>
                         <Button Content="Reset (Center)" Click="OnResetClick" Margin="0,0,10,10"/>
                         <Button Content="Animate to End" Click="OnAnimateToEndClick" Margin="0,0,10,10"/>
                         <CheckBox Content="Reverse Direction" IsChecked="{Binding #InteractiveSlider.IsDirectionReversed}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Text/Code Comparison -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Content Comparison" />
                    <TextBlock Text="Compare arbitrary content, like code diffs." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider Height="200">
                        <controls:CompareSlider.Styles>
                             <Style Selector="controls|CompareSlider /template/ Thumb#PART_Thumb">
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="CornerRadius" Value="16"/>
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                             <Style Selector="controls|CompareSlider /template/ Line#PART_Divider">
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </Style>
                        </controls:CompareSlider.Styles>
                        
                        <controls:CompareSlider.BeforeContent>
                            <Border Background="#1E1E1E" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="ORIGINAL" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="public void Update() {" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                    <TextBlock Text="    if (isActive) {" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                    <TextBlock Text="        Process();" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                    <TextBlock Text="    }" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                    <TextBlock Text="}" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                </StackPanel>
                            </Border>
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Border Background="#252526" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="REFACTORED" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="public void Update() =>" FontFamily="Consolas, Monospace" Foreground="#D4D4D4"/>
                                    <TextBlock Text="    isActive ? Process() : null;" FontFamily="Consolas, Monospace" Foreground="#CE9178"/>
                                </StackPanel>
                            </Border>
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>
                </StackPanel>
            </Border>
            
            <!-- Custom Styling -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Custom Styling" />
                    <TextBlock Text="Customizing the divider and thumb using inline styles." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider Height="300">
                        <controls:CompareSlider.Styles>
                            <Style Selector="controls|CompareSlider /template/ Line#PART_Divider">
                                <Setter Property="Stroke" Value="Orange" />
                                <Setter Property="StrokeThickness" Value="4" />
                            </Style>
                             <Style Selector="controls|CompareSlider /template/ Thumb#PART_Thumb">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="60" />
                                <Setter Property="Background" Value="Orange" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderBrush" Value="DarkOrange" />
                            </Style>
                        </controls:CompareSlider.Styles>

                        <controls:CompareSlider.BeforeContent>
                             <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/summer.png" Stretch="UniformToFill">
                                <Image.Effect>
                                    <BlurEffect Radius="20"/>
                                </Image.Effect>
                             </Image>
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Image Source="avares://Nova.Avalonia.UI.Gallery/Assets/summer.png" Stretch="UniformToFill" />
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>
                </StackPanel>
            </Border>

            <!-- Custom Range Usage -->
            <Border Classes="stage" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionlabel" Text="Custom Range Usage" />
                    <TextBlock Text="Map values to a specific domain (e.g., timeline progression)." Foreground="{DynamicResource SecondaryTextBrush}" />
                    
                    <controls:CompareSlider Height="300" 
                                            Minimum="1990" 
                                            Maximum="2026" 
                                            Value="2003"
                                            SmallChange="1"
                                            LargeChange="5"
                                            x:Name="RangeSlider">
                        <controls:CompareSlider.BeforeContent>
                             <Border Background="#1A1B26">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="1990" 
                                               FontSize="56" 
                                               FontWeight="Black" 
                                               Foreground="White" 
                                               HorizontalAlignment="Center"
                                               Opacity="0.8"/>
                                    <TextBlock Text="THE PAST" 
                                               FontSize="16" 
                                               FontWeight="Medium"
                                               LetterSpacing="4"
                                               Foreground="#7AA2F7" 
                                               HorizontalAlignment="Center"
                                               Opacity="0.6"/>
                                </StackPanel>
                             </Border>
                        </controls:CompareSlider.BeforeContent>
                        <controls:CompareSlider.AfterContent>
                             <Border Background="#F7768E">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="2026" 
                                               FontSize="56" 
                                               FontWeight="Black" 
                                               Foreground="White" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="THE FUTURE" 
                                               FontSize="16" 
                                               FontWeight="Medium"
                                               LetterSpacing="4"
                                               Foreground="#FFF" 
                                               HorizontalAlignment="Center"
                                               Opacity="0.8"/>
                                </StackPanel>
                             </Border>
                        </controls:CompareSlider.AfterContent>
                    </controls:CompareSlider>

                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current Year:" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding #RangeSlider.Value, StringFormat=\{0:F0\}}" 
                                       FontWeight="Black" 
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="22"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
