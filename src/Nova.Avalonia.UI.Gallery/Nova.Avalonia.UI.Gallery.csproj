<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <EmbeddedResource Include="Views\*.axaml" />
        <EmbeddedResource Include="Views\*.axaml.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Themes.Simple"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Nova.Avalonia.UI\Nova.Avalonia.UI.csproj" />
      <ProjectReference Include="..\Nova.Avalonia.UI.BarcodeGenerator\Nova.Avalonia.UI.BarcodeGenerator.csproj" />
      <ProjectReference Include="..\Nova.Avalonia.UI.CodeViewer\Nova.Avalonia.UI.CodeViewer.csproj" />
    </ItemGroup>
</Project>
